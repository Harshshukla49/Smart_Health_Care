# ==============================================================================
# SMART HEALTH CARE - DEDICATED STAGING BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.staging or configure these values in your isolated staging
# cloud host (e.g. Render Web Service: smart-health-backend-staging).
#
# STRICT ISOLATION RULES:
# 1. NEVER point staging to the production Firebase database (smart-health-care-cd723).
# 2. Keep SMS and Email credentials blank or unconfigured to ensure 100% simulated
#    notification dispatch without triggering real emergency dispatches.
# 3. Always use synthetic patient records for staging testing.
# ==============================================================================

# --- SERVER CONFIGURATION ---
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
ENVIRONMENT=staging

# Production/Staging authentication secret (must be >= 32 characters)
APP_AUTH_SECRET=staging_cryptographically_secure_random_key_min_32_characters_long
JWT_SECRET=staging_cryptographically_secure_random_key_min_32_characters_long
AUTH_TOKEN_TTL_SECONDS=43200
DEFAULT_PHONE_COUNTRY_CODE=+91

# --- CORS & ISOLATION ---
# Staging backend must ONLY accept requests from the staging frontend domain and local test harnesses
CORS_ORIGIN=https://smart-health-frontend-staging.onrender.com,http://localhost:5173

# --- DEDICATED STAGING FIREBASE REALTIME DATABASE ---
# Create a dedicated free Firebase project (e.g. smart-health-care-staging) under Spark Free Tier
FIREBASE_DATABASE_URL=https://smart-health-care-staging-default-rtdb.asia-southeast1.firebasedatabase.app/
# Staging service account private key JSON (single-line JSON string in Render Dashboard)
FIREBASE_CREDENTIALS_JSON=

# --- SUPER ADMIN BOOTSTRAP (STAGING) ---
SUPER_ADMIN_EMAIL=staging-admin@smarthealth.io
SUPER_ADMIN_PASSWORD=StagingAdminPass2026!Secure

# --- NOTIFICATION SERVICES: TWILIO SMS (SAFELY MUTED / MOCKED IN STAGING) ---
# Leave blank in staging to ensure notifications are logged/simulated without sending real SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
PATIENT_PHONE=

# --- NOTIFICATION SERVICES: SMTP / GMAIL (SAFELY MUTED / MOCKED IN STAGING) ---
# Leave blank in staging to prevent real emails from being dispatched
EMAIL_SENDER=
EMAIL_PASSWORD=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- IOT WEARABLE & SENSOR TELEMETRY ---
# Always keep simulated for staging unless testing a dedicated hardware staging rig
SENSOR_ADAPTER=simulated
ALLOW_DEV_DEVICE_INSECURE=false
