# ==============================================================================
# SMART HEALTH CARE - DEDICATED STAGING FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Configure these variables in the Render static service: smart-health-frontend-staging
# or copy to frontend/.env.staging for local staging builds.
#
# STRICT ISOLATION RULES:
# 1. Point VITE_API_BASE_URL ONLY to the isolated staging backend.
# 2. Point VITE_FIREBASE_* ONLY to the dedicated staging Firebase project.
# ==============================================================================

# Staging Backend API Base URLs
VITE_API_BASE_URL=https://smart-health-backend-staging.onrender.com
VITE_SOS_API_BASE_URL=https://smart-health-backend-staging.onrender.com

# Dedicated Staging Firebase Project (Spark Plan - $0/mo)
# Obtain these values from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=AIzaSyStagingExampleKeyNotReal_123456789
VITE_FIREBASE_AUTH_DOMAIN=smart-health-care-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-health-care-staging
VITE_FIREBASE_APP_ID=1:123456789012:web:stagingappid123456
VITE_FIREBASE_DATABASE_URL=https://smart-health-care-staging-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_STORAGE_BUCKET=smart-health-care-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_MEASUREMENT_ID=G-STAGING0000
