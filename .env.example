# ==============================================================================
# SMART HEALTH CARE MONITORING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit real credentials or .env files to version control.

# --- SERVER CONFIGURATION ---
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
# Production authentication secret (must be >= 32 characters in production)
# Backend checks APP_AUTH_SECRET first, falling back to JWT_SECRET
APP_AUTH_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
AUTH_TOKEN_TTL_SECONDS=43200
DEFAULT_PHONE_COUNTRY_CODE=+91

# --- CORS & SECURITY ---
# Comma-separated list of allowed frontend origins (e.g. production domain, local dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- FIREBASE REALTIME DATABASE ---
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/
# Set either FIREBASE_CREDENTIALS_JSON (raw JSON string) or place firebase_key.json in root
FIREBASE_CREDENTIALS_JSON=

# --- SUPER ADMIN BOOTSTRAP (FIRST RUN) ---
SUPER_ADMIN_EMAIL=admin@smarthealth.io
SUPER_ADMIN_PASSWORD=ChangeMeInProduction!2026

# --- NOTIFICATION SERVICES: TWILIO SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
PATIENT_PHONE=

# --- NOTIFICATION SERVICES: SMTP / GMAIL ALERTS ---
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- IOT WEARABLE & SENSOR TELEMETRY ---
# SENSOR_ADAPTER modes: simulated | dataset | esp32_hardware
SENSOR_ADAPTER=simulated
# In production, ALWAYS leave ALLOW_DEV_DEVICE_INSECURE as false (requires signed tokens)
ALLOW_DEV_DEVICE_INSECURE=false
